# Byte-compiled / caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.env

# Test suite: kept locally, not part of the published repo
tests/

# Run outputs. Every one of these is regenerated by main.py or a notebook.
#
# Anchored with a leading slash. `features/` without one matches at ANY depth,
# and the default feature_cache_dir is literally "features" — so the pattern
# meant for the output directory also swallowed the `features/` PACKAGE. Files
# committed before the rule existed stayed tracked, which hid it: only newly
# added modules disappeared, and then only on a fresh clone, where the notebook
# fails with ModuleNotFoundError instead of anything pointing at .gitignore.
/checkpoints/
/features/*.npy
/features/*.json
/cellvit_features/
/outputs/
*.pt
*.npy
*.npz
*.h5
*.log
*.zip
